---
import Layout from "../layouts/Layout.astro";
import Paginate from "../components/Paginate";
import StatsTracker from "../components/StatsTracker";
import { getSession } from "../lib/db";
import { prepareStatements, createSQLLog } from "../lib/utils";
import { LayerCard, Link, LinkButton, Table, Text } from "@cloudflare/kumo";
import { ArrowClockwiseIcon } from "@phosphor-icons/react";

const session = getSession();
const page = parseInt(Astro.url.searchParams.get("page") ?? "1") || 1;
const itemsPerPage = 20;

const [stmts, sql] = prepareStatements(
  session,
  '"Order"',
  [
    'SELECT SUM(od.UnitPrice * od.Discount * od.Quantity) AS TotalProductsDiscount, SUM(od.UnitPrice * od.Quantity) AS TotalProductsPrice, SUM(od.Quantity) AS TotalProductsItems, COUNT(od.OrderId) AS TotalProducts, o.Id, o.CustomerId, o.EmployeeId, o.OrderDate, o.RequiredDate, o.ShippedDate, o.ShipVia, o.Freight, o.ShipName, o.ShipAddress, o.ShipCity, o.ShipRegion, o.ShipPostalCode, o.ShipCountry FROM (SELECT * FROM "Order" ORDER BY Id LIMIT ?1 OFFSET ?2) o LEFT JOIN OrderDetail od ON od.OrderId = o.Id GROUP BY o.Id ORDER BY o.Id',
  ],
  [[itemsPerPage, (page - 1) * itemsPerPage]],
);

let orders: any[] = [];
let total = 0;
let stats: any;
let error: string | undefined;
let msg: string | undefined;

try {
  const startTime = Date.now();
  const response = await session.batch(stmts);
  const overallTimeMs = Date.now() - startTime;

  total = (response[0].results?.[0] as any)?.total ?? 0;
  orders = (response.slice(1)[0].results ?? []) as any[];

  stats = {
    queries: stmts.length,
    results: orders.length + 1,
    select: stmts.length,
    log: createSQLLog(sql, response, overallTimeMs),
  };
} catch (e: any) {
  error = "404";
  msg = e.toString();
}

const pages = Math.ceil(total / itemsPerPage);
const currentUrl = `${Astro.url.pathname}${Astro.url.search}`;
---

<Layout>
  {orders.length ? (
    <LayerCard className="p-0">
      <div class="flex items-center justify-between border-b border-kumo-hairline px-4 py-3">
        <Text variant="heading3" as="h2">Orders</Text>
        <LinkButton
          href={currentUrl}
          variant="ghost"
          size="sm"
          shape="square"
          aria-label="Refresh"
        >
          <ArrowClockwiseIcon size={16} />
        </LinkButton>
      </div>
      <div class="overflow-x-auto">
        <Table>
          <Table.Header>
            <Table.Row>
              <Table.Head>Id</Table.Head>
              <Table.Head>Total Price</Table.Head>
              <Table.Head>Products</Table.Head>
              <Table.Head>Quantity</Table.Head>
              <Table.Head>Shipped</Table.Head>
              <Table.Head>Ship Name</Table.Head>
              <Table.Head>City</Table.Head>
              <Table.Head>Country</Table.Head>
            </Table.Row>
          </Table.Header>
          <Table.Body>
            {orders.map((order: any) => (
              <Table.Row>
                <Table.Cell>
                  <Link href={`/order/${order.Id}`}>{order.Id}</Link>
                </Table.Cell>
                <Table.Cell>{`$${parseFloat(order.TotalProductsPrice).toFixed(2)}`}</Table.Cell>
                <Table.Cell>{order.TotalProducts}</Table.Cell>
                <Table.Cell>{order.TotalProductsItems}</Table.Cell>
                <Table.Cell>{order.OrderDate}</Table.Cell>
                <Table.Cell>{order.ShipName}</Table.Cell>
                <Table.Cell>{order.ShipCity}</Table.Cell>
                <Table.Cell>{order.ShipCountry}</Table.Cell>
              </Table.Row>
            ))}
          </Table.Body>
        </Table>
      </div>
      <Paginate page={page} pages={pages} base="/orders" />
    </LayerCard>
  ) : (
    <LayerCard className="p-6">
      {error ? (
        <Text variant="error">{msg}</Text>
      ) : (
        <Text variant="secondary">Loading orders...</Text>
      )}
    </LayerCard>
  )}
  {stats && <StatsTracker stats={stats} client:load />}
</Layout>
