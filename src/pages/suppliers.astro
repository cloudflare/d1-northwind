---
import Layout from "../layouts/Layout.astro";
import Paginate from "../components/Paginate";
import StatsTracker from "../components/StatsTracker";
import { getSession } from "../lib/db";
import { prepareStatements, createSQLLog } from "../lib/utils";

const session = getSession();
const page = parseInt(Astro.url.searchParams.get("page") ?? "1") || 1;
const itemsPerPage = 20;

const [stmts, sql] = prepareStatements(
  session,
  "Supplier",
  [
    "SELECT Id,CompanyName,ContactName,ContactTitle, Address, City, Region, PostalCode, Country, Phone, Fax, HomePage FROM Supplier LIMIT ?1 OFFSET ?2",
  ],
  [[itemsPerPage, (page - 1) * itemsPerPage]],
);

const startTime = Date.now();
const response = await session.batch(stmts);
const overallTimeMs = Date.now() - startTime;

const total = (response[0].results?.[0] as any)?.total ?? 0;
const suppliers = (response.slice(1)[0].results ?? []) as any[];
const pages = Math.ceil(total / itemsPerPage);

const stats = {
  queries: stmts.length,
  results: suppliers.length + 1,
  select: stmts.length,
  log: createSQLLog(sql, response, overallTimeMs),
};
---

<Layout>
  {suppliers.length ? (
    <div class="card has-table">
      <header class="card-header">
        <p class="card-header-title">Suppliers</p>
        <a class="card-header-icon" href={`${Astro.url.pathname}${Astro.url.search}`}>
          <span class="material-icons">redo</span>
        </a>
      </header>
      <div class="card-content">
        <table>
          <thead>
            <tr>
              <th></th>
              <th>Company</th>
              <th>Contact</th>
              <th>Title</th>
              <th>City</th>
              <th>Country</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {suppliers.map((supplier: any) => {
              const avatar = `https://api.dicebear.com/9.x/initials/svg?seed=${supplier.ContactName.split(" ")[0]}-${supplier.ContactName.split(" ").slice(-1)[0]}`;
              return (
                <tr>
                  <td class="image-cell">
                    <div class="image">
                      <img alt="supplier" src={avatar} class="rounded-full" />
                    </div>
                  </td>
                  <td data-label="Company">
                    <a class="link" href={`/supplier/${supplier.Id}`}>
                      {supplier.CompanyName}
                    </a>
                  </td>
                  <td data-label="Contact">{supplier.ContactName}</td>
                  <td data-label="Title">{supplier.ContactTitle}</td>
                  <td data-label="City">{supplier.City}</td>
                  <td data-label="Country">{supplier.Country}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <Paginate pages={pages} page={page} base="/suppliers" />
      </div>
    </div>
  ) : (
    <div class="card-content">
      <h2>Loading suppliers...</h2>
    </div>
  )}
  <StatsTracker stats={stats} client:load />
</Layout>
