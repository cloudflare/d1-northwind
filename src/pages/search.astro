---
import Layout from "../layouts/Layout.astro";
import StatsTracker from "../components/StatsTracker";
import { getSession } from "../lib/db";
import { prepareStatements, createSQLLog } from "../lib/utils";

const session = getSession();
const q = Astro.url.searchParams.get("q");
const table = Astro.url.searchParams.get("table") ?? "products";

let results: any[] = [];
let stats: any;

if (q) {
  const [stmts, sql] = prepareStatements(
    session,
    false,
    [
      table === "products"
        ? "SELECT Id, ProductName, SupplierId, CategoryId, QuantityPerUnit, UnitPrice, UnitsInStock, UnitsOnOrder, ReorderLevel, Discontinued FROM Product WHERE ProductName LIKE ?2 LIMIT ?1"
        : "SELECT Id, CompanyName, ContactName, ContactTitle, Address, City, Region, PostalCode, Country, Phone, Fax FROM Customer WHERE CompanyName LIKE ?2 OR ContactName LIKE ?2 OR ContactTitle LIKE ?2 OR Address LIKE ?2 LIMIT ?1",
    ],
    [[20, `%${q}%`]],
  );

  const startTime = Date.now();
  const search = await stmts[0].all();
  const overallTimeMs = Date.now() - startTime;

  results = (search.results ?? []) as any[];

  stats = {
    queries: 1,
    results: results.length,
    select_where: 1,
    log: createSQLLog(sql, [search], overallTimeMs),
  };
}
---

<Layout>
  <div class="card">
    <div class="card-content">
      <form action="/search" method="get">
        <div class="field">
          <label class="label">Search Database</label>
          <div class="field-body">
            <div class="field">
              <div class="control icons-left">
                <input
                  name="q"
                  placeholder="Enter keyword..."
                  value={q ?? ""}
                  class="input w-1/2"
                />
                <span class="icon left material-icons ml-2 mt-2">search</span>
              </div>
            </div>
          </div>
        </div>

        <div class="field">
          <label class="label">Tables</label>
          <div class="field-body">
            <div class="field grouped multiline">
              <div class="control">
                <label class="radio">
                  <input
                    type="radio"
                    name="table"
                    value="products"
                    checked={table === "products"}
                  />
                  <span class="check"></span>
                  <span class="control-label">Products</span>
                </label>
              </div>
              <div class="control">
                <label class="radio">
                  <input
                    type="radio"
                    name="table"
                    value="customers"
                    checked={table === "customers"}
                  />
                  <span class="check"></span>
                  <span class="control-label">Customers</span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <div class="field">
          <div class="control">
            <button type="submit" class="button blue">Search</button>
          </div>
        </div>
      </form>

      <p class="text-black font-bold text-lg">Search results</p>
      {results.length ? (
        <>
          {results.map((r: any, idx: number) =>
            table === "products" ? (
              <>
                <p class="text-base mt-2 link">
                  <a href={`/product/${r.Id}`}>{r.ProductName}</a>
                </p>
                <p class="text-gray-400 text-sm">
                  #{idx + 1}, Quantity Per Unit: {r.QuantityPerUnit}, Price:{" "}
                  {r.UnitPrice}, Stock: {r.UnitsInStock}
                </p>
              </>
            ) : (
              <>
                <p class="text-base mt-2 link">
                  <a href={`/customer/${r.Id}`}>{r.CompanyName}</a>
                </p>
                <p class="text-gray-400 text-sm">
                  #{idx + 1}, Contact: {r.ContactName}, Title: {r.ContactTitle},
                  Phone: {r.Phone}
                </p>
              </>
            ),
          )}
        </>
      ) : (
        <p class="mt-6">No results</p>
      )}
    </div>
  </div>
  {stats && <StatsTracker stats={stats} client:load />}
</Layout>
