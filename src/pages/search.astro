---
import Layout from "../layouts/Layout.astro";
import { LayerCard, Link, Text } from "@cloudflare/kumo";

const query = (Astro.url.searchParams.get("q") ?? "").trim();
const requestedTarget =
  Astro.url.searchParams.get("target") ??
  Astro.url.searchParams.get("table") ??
  "product";
const targetPaths: Record<string, string> = {
  product: "/products",
  products: "/products",
  customer: "/customers",
  customers: "/customers",
};
const path = targetPaths[requestedTarget];

if (path) {
  const destination = new URL(path, Astro.url);
  if (query) destination.searchParams.set("q", query);
  return Astro.redirect(`${destination.pathname}${destination.search}`, 308);
}

Astro.response.status = 400;
---

<Layout title="Search — Northwind Traders">
  <LayerCard className="p-6">
    <Text variant="heading3" as="h2">Choose a list to search</Text>
    <div class="mt-4 flex gap-4">
      <Link href="/products">Products</Link>
      <Link href="/customers">Customers</Link>
    </div>
  </LayerCard>
</Layout>
