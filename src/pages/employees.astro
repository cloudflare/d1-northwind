---
import Layout from "../layouts/Layout.astro";
import Paginate from "../components/Paginate";
import StatsTracker from "../components/StatsTracker";
import { getSession } from "../lib/db";
import { prepareStatements, createSQLLog } from "../lib/utils";

const session = getSession();
const page = parseInt(Astro.url.searchParams.get("page") ?? "1") || 1;
const itemsPerPage = 20;

const [stmts, sql] = prepareStatements(
  session,
  "Employee",
  [
    "SELECT Id, LastName, FirstName, Title, TitleOfCourtesy, BirthDate, HireDate, Address, City, Region, PostalCode, Country, HomePhone, Extension, Photo, Notes, ReportsTo, PhotoPath FROM Employee LIMIT ?1 OFFSET ?2",
  ],
  [[itemsPerPage, (page - 1) * itemsPerPage]],
);

const startTime = Date.now();
const response = await session.batch(stmts);
const overallTimeMs = Date.now() - startTime;

const total = (response[0].results?.[0] as any)?.total ?? 0;
const employees = (response.slice(1)[0].results ?? []) as any[];
const pages = Math.ceil(total / itemsPerPage);

const stats = {
  queries: stmts.length,
  results: employees.length + 1,
  select: stmts.length,
  log: createSQLLog(sql, response, overallTimeMs),
};
---

<Layout>
  {employees.length ? (
    <div class="card has-table">
      <header class="card-header">
        <p class="card-header-title">Employees</p>
        <a class="card-header-icon" href={`${Astro.url.pathname}${Astro.url.search}`}>
          <span class="material-icons">redo</span>
        </a>
      </header>
      <div class="card-content">
        <table>
          <thead>
            <tr>
              <th></th>
              <th>Name</th>
              <th>Title</th>
              <th>City</th>
              <th>Phone</th>
              <th>Country</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {employees.map((employee: any) => {
              const avatar = `https://api.dicebear.com/9.x/initials/svg?seed=${employee.FirstName[0]}-${employee.LastName[0]}`;
              return (
                <tr>
                  <td class="image-cell">
                    <div class="image">
                      <img alt="employee avatar" src={avatar} class="rounded-full" />
                    </div>
                  </td>
                  <td data-label="Name">
                    <a class="link" href={`/employee/${employee.Id}`}>
                      {`${employee.FirstName} ${employee.LastName}`}
                    </a>
                  </td>
                  <td data-label="Title">{employee.Title}</td>
                  <td data-label="City">{employee.City}</td>
                  <td data-label="Phone">{employee.HomePhone}</td>
                  <td data-label="Country">{employee.Country}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <Paginate pages={pages} page={page} base="/employees" />
      </div>
    </div>
  ) : (
    <div class="card-content">
      <h2>No results</h2>
    </div>
  )}
  <StatsTracker stats={stats} client:load />
</Layout>
