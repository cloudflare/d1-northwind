---
import Layout from "../layouts/Layout.astro";
import Paginate from "../components/Paginate";
import StatsTracker from "../components/StatsTracker";
import { getSession } from "../lib/db";
import { prepareStatements, createSQLLog } from "../lib/utils";
import { LayerCard, Link, LinkButton, Table, Text } from "@cloudflare/kumo";
import { ArrowClockwiseIcon } from "@phosphor-icons/react";

const session = getSession();
const page = parseInt(Astro.url.searchParams.get("page") ?? "1") || 1;
const itemsPerPage = 20;

const [stmts, sql] = prepareStatements(
  session,
  "Product",
  [
    "SELECT Id, ProductName, SupplierId, CategoryId, QuantityPerUnit, UnitPrice, UnitsInStock, UnitsOnOrder, ReorderLevel, Discontinued FROM Product LIMIT ?1 OFFSET ?2",
  ],
  [[itemsPerPage, (page - 1) * itemsPerPage]],
);

const startTime = Date.now();
const response = await session.batch(stmts);
const overallTimeMs = Date.now() - startTime;

const total = (response[0].results?.[0] as any)?.total ?? 0;
const products = (response.slice(1)[0].results ?? []) as any[];
const pages = Math.ceil(total / itemsPerPage);

const stats = {
  queries: stmts.length,
  results: products.length + 1,
  select: stmts.length,
  log: createSQLLog(sql, response, overallTimeMs),
};

const currentUrl = `${Astro.url.pathname}${Astro.url.search}`;
---

<Layout>
  {products.length ? (
    <LayerCard className="p-0">
      <div class="flex items-center justify-between border-b border-kumo-hairline px-4 py-3">
        <Text variant="heading3" as="h2">Products</Text>
        <LinkButton
          href={currentUrl}
          variant="ghost"
          size="sm"
          shape="square"
          aria-label="Refresh"
        >
          <ArrowClockwiseIcon size={16} />
        </LinkButton>
      </div>
      <div class="overflow-x-auto">
        <Table>
          <Table.Header>
            <Table.Row>
              <Table.Head>Name</Table.Head>
              <Table.Head>Qt per unit</Table.Head>
              <Table.Head>Price</Table.Head>
              <Table.Head>Stock</Table.Head>
              <Table.Head>Orders</Table.Head>
            </Table.Row>
          </Table.Header>
          <Table.Body>
            {products.map((product: any) => (
              <Table.Row>
                <Table.Cell>
                  <Link href={`/product/${product.Id}`}>
                    {product.ProductName}
                  </Link>
                </Table.Cell>
                <Table.Cell>{product.QuantityPerUnit}</Table.Cell>
                <Table.Cell>${product.UnitPrice}</Table.Cell>
                <Table.Cell>{product.UnitsInStock}</Table.Cell>
                <Table.Cell>{product.UnitsOnOrder}</Table.Cell>
              </Table.Row>
            ))}
          </Table.Body>
        </Table>
      </div>
      <Paginate page={page} pages={pages} base="/products" />
    </LayerCard>
  ) : (
    <LayerCard className="p-6">
      <Text variant="secondary">No results</Text>
    </LayerCard>
  )}
  <StatsTracker stats={stats} client:load />
</Layout>
