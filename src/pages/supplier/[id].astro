---
import Layout from "../../layouts/Layout.astro";
import StatsTracker from "../../components/StatsTracker";
import AddTableField from "../../components/AddTableField";
import { getSession } from "../../lib/db";
import { prepareStatements, createSQLLog } from "../../lib/utils";
import { LayerCard, LinkButton, Text } from "@cloudflare/kumo";

const session = getSession();
const { id } = Astro.params;

const [stmts, sql] = prepareStatements(
  session,
  false,
  [
    "SELECT Id,CompanyName,ContactName,ContactTitle, Address, City, Region, PostalCode, Country, Phone, Fax, HomePage FROM Supplier WHERE Id = ?1",
  ],
  [[id]],
);

const startTime = Date.now();
const result = await stmts[0].all();
const overallTimeMs = Date.now() - startTime;

const supplier = (result.results[0] ?? null) as any;

const stats = {
  queries: 1,
  results: 1,
  select: 1,
  log: createSQLLog(sql, [result], overallTimeMs),
};
---

<Layout>
  {supplier ? (
    <LayerCard className="p-6">
      <Text variant="heading3" as="h2">Supplier information</Text>
      <div class="mt-4 grid grid-cols-1 gap-x-6 sm:grid-cols-2">
        <div>
          <AddTableField name="Company Name" value={supplier.CompanyName} />
          <AddTableField name="Contact Name" value={supplier.ContactName} />
          <AddTableField name="Contact Title" value={supplier.ContactTitle} />
          <AddTableField name="Address" value={supplier.Address} />
          <AddTableField name="City" value={supplier.City} />
        </div>
        <div>
          <AddTableField name="Region" value={supplier.Region} />
          <AddTableField name="Postal Code" value={supplier.PostalCode} />
          <AddTableField name="Country" value={supplier.Country} />
          <AddTableField name="Phone" value={supplier.Phone} />
          {supplier.Fax ? (
            <AddTableField name="Fax" value={supplier.Fax} />
          ) : null}
          {supplier.HomePage ? (
            <AddTableField name="Home Page" value={supplier.HomePage} />
          ) : null}
        </div>
      </div>
      <div class="mt-6">
        <LinkButton href="/suppliers" variant="secondary">Go back</LinkButton>
      </div>
    </LayerCard>
  ) : (
    <LayerCard className="p-6">
      <Text variant="secondary">No such supplier</Text>
    </LayerCard>
  )}
  <StatsTracker stats={stats} client:load />
</Layout>
