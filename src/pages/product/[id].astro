---
import Layout from "../../layouts/Layout.astro";
import StatsTracker from "../../components/StatsTracker";
import AddTableField from "../../components/AddTableField";
import { getSession } from "../../lib/db";
import { prepareStatements, createSQLLog } from "../../lib/utils";
import { LayerCard, LinkButton, Text } from "@cloudflare/kumo";

const session = getSession();
const { id } = Astro.params;

const [stmts, sql] = prepareStatements(
  session,
  false,
  [
    "SELECT Product.Id, ProductName, SupplierId, CategoryId, QuantityPerUnit, UnitPrice, UnitsInStock, UnitsOnOrder, ReorderLevel, Discontinued, Supplier.CompanyName AS SupplierName FROM Product, Supplier WHERE Product.Id = ?1 AND Supplier.Id=Product.SupplierId",
  ],
  [[id]],
);

const startTime = Date.now();
const result = await stmts[0].all();
const overallTimeMs = Date.now() - startTime;

const product = (result.results[0] ?? null) as any;

const stats = {
  queries: 1,
  results: 1,
  select: 1,
  log: createSQLLog(sql, [result], overallTimeMs),
};
---

<Layout>
  {product ? (
    <LayerCard className="p-6">
      <Text variant="heading3" as="h2">Product information</Text>
      <div class="mt-4 grid grid-cols-1 gap-x-6 sm:grid-cols-2">
        <div>
          <AddTableField name="Product Name" value={product.ProductName} />
          <AddTableField
            name="Supplier"
            link={`/supplier/${product.SupplierId}`}
            value={product.SupplierName}
          />
          <AddTableField
            name="Quantity Per Unit"
            value={product.QuantityPerUnit}
          />
          <AddTableField name="Unit Price" value={`$${product.UnitPrice}`} />
        </div>
        <div>
          <AddTableField name="Units In Stock" value={product.UnitsInStock} />
          <AddTableField name="Units In Order" value={product.UnitsOnOrder} />
          <AddTableField name="Reorder Level" value={product.ReorderLevel} />
          <AddTableField name="Discontinued" value={product.Discontinued} />
        </div>
      </div>
      <div class="mt-6">
        <LinkButton href="/products" variant="secondary">Go back</LinkButton>
      </div>
    </LayerCard>
  ) : (
    <LayerCard className="p-6">
      <Text variant="secondary">No such product</Text>
    </LayerCard>
  )}
  <StatsTracker stats={stats} client:load />
</Layout>
